DATABASE_URL="postgresql://USER@localhost:5432/gnoud_book"
PORT=4000
JWT_SECRET="change-me-to-a-long-random-string"
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Gnoud Book <no-reply@gnoud-book.local>"
WEB_URL=http://localhost:3000

# Tuỳ chọn: lịch quét email nhắc (mặc định mỗi 5 phút) và thời gian chờ giữa các lần thử lại job (giây)
# REMINDER_SWEEP_CRON="*/5 * * * *"
# JOBS_RETRY_DELAY_SECONDS=30

# --- Gửi email THẬT (thay cho Mailpit) ---------------------------------------------------------
# Mặc định (localhost:1025) là Mailpit: hộp thư giả, thư KHÔNG ra Internet, xem ở http://localhost:8025.
# Để gửi tới hộp thư thật, dùng một dịch vụ SMTP. Ví dụ Gmail (cần bật xác minh 2 bước, rồi tạo
# "Mật khẩu ứng dụng" tại https://myaccount.google.com/apppasswords, KHÔNG dùng mật khẩu Gmail thường):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=ban@gmail.com
# SMTP_PASS=abcdefghijklmnop          # mật khẩu ứng dụng 16 ký tự, viết liền
# MAIL_FROM="Gnoud Book <ban@gmail.com>"   # với Gmail, địa chỉ gửi đi luôn là chính tài khoản Gmail
# Sửa .env xong phải khởi động lại `pnpm dev`, rồi thử bằng: pnpm --filter @gnoud-book/api mail:test ban@gmail.com


# --- Chỉ cần khi chạy production (NODE_ENV=production) -----------------------------------------
# API sẽ từ chối khởi động nếu JWT_SECRET yếu, WEB_URL / SMTP_HOST còn là localhost (xem README).
# TRUST_PROXY=1        # số lớp proxy đứng trước API, để giới hạn tốc độ nhận đúng IP khách
# SWAGGER_ENABLED=true # /docs mặc định tắt ở production
